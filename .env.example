# Text to Speech Workbench: copy this file to .env and set your key.
#   cp .env.example .env
# .env is git-ignored; never commit a real key.

# ─── App ─────────────────────────────────────────────────────────────
# Where `npm run dev` / `npm start` listen (scripts/run.mjs).
APP_HOST=localhost
APP_PORT=9000

# ─── AssemblyAI ──────────────────────────────────────────────────────
# Required. Create one at https://www.assemblyai.com/dashboard
# Sent raw in the Authorization header (not "Bearer ..."), server-side only.
ASSEMBLYAI_API_KEY=

# Streaming endpoint. US: wss://tts.us.assemblyai.com/v1/ws
#                     EU: wss://tts.eu.assemblyai.com/v1/ws
ASSEMBLYAI_API_TTS_URL=wss://tts.us.assemblyai.com/v1/ws

# Model, sent as the model_id connect parameter.
ASSEMBLYAI_API_TTS_MODEL=assemblyai-tts-1

# Default voice: a preset slug (aai-alba, aai-anna, aai-charles, aai-eve, aai-george,
# aai-jane, aai-jean, aai-mary, aai-michael, aai-paul, aai-vera), any library slug,
# or a voice UUID. `npm run voices` lists them all.
ASSEMBLYAI_API_TTS_VOICE=aai-jane

# Default language: english, spanish, german, french, italian or portuguese.
ASSEMBLYAI_API_TTS_LANGUAGE=english

# Optional. Output sample rate in Hz: 8000, 16000, 22050, 24000, 44100 or 48000.
# ASSEMBLYAI_API_TTS_SAMPLE_RATE=24000
